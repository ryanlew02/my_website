# Clean URLs — serve pages without the .html extension.

# MultiViews would do its own content negotiation and fight the rules below.
Options -MultiViews

DirectoryIndex index.html

RewriteEngine On

# 1. /foo/index.html  ->  /foo/        (301, keeps query string)
RewriteCond %{THE_REQUEST} \s/(.+/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. /foo.html  ->  /foo               (301, keeps query string)
RewriteCond %{THE_REQUEST} \s/(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. /foo  ->  /foo.html               (internal, only if the file exists)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
