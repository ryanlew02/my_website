---
import TermPage from '../../components/TermPage.astro';
import { getPosts, collectTerms, tagsOf, type Post, type Term } from '../../lib/posts';
import { slugify } from '../../lib/text';

export async function getStaticPaths() {
    const posts = await getPosts();
    const all = collectTerms(posts, tagsOf);
    return all.map((term) => ({
        params: { tag: term.slug },
        props: { term, all, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === term.slug)) },
    }));
}
interface Props { term: Term; all: Term[]; posts: Post[] }
const { term, all, posts } = Astro.props;
---
<TermPage kind="Tag" base="tags" term={term} all={all} posts={posts} />
