---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import SearchBox from '../components/SearchBox.astro';
import TermChips from '../components/TermChips.astro';
import Icon from '../components/Icon.astro';
import { getPosts, collectTerms, tagsOf, categoryOf } from '../lib/posts';
import { slugify } from '../lib/text';
import { formatDate, isoDate, readingTime } from '../lib/text';
import { SITE, absolute } from '../lib/site';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
const categories = collectTerms(posts, categoryOf);
const tags = collectTerms(posts, tagsOf);

// "Posts by tag": every tag with its newest few posts.
const PER_TAG = 5;
const byTag = tags.map((t) => ({
    ...t,
    posts: posts.filter((p) => p.data.tags.some((name) => slugify(name) === t.slug)).slice(0, PER_TAG),
}));

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: SITE.title,
    url: absolute('/blog/'),
    description: SITE.description,
    author: { '@type': 'Person', name: SITE.author, url: SITE.origin },
};
---
<Base title={SITE.title} canonical="/blog/" jsonLd={jsonLd} current="blog">
    <div class="wrap">
        <header class="masthead masthead--index">
            <div>
                <div class="kicker"><span>Writing</span><span>Notes</span><span>{new Date().getFullYear()}</span></div>
                <h1 class="page-title" style="margin-top: 16px">The Journey To Coding A Simulation</h1>
                <p class="lede">nAI (non-ai) writing. Raw thoughts, not polished.</p>
            </div>
            <div class="masthead-tools">
                <SearchBox />
                <a class="stat" href="/blog/rss.xml"><Icon name="rss" size={13} /> RSS feed</a>
            </div>
        </header>

        <div class="index-grid">
            <div>
                {featured && (
                    <section aria-labelledby="latest-label">
                        <div class="section-label" id="latest-label">{featured.data.featured ? 'Featured' : 'Latest'}</div>
                        <a class="featured" href={`/blog/${featured.id}/`} data-post-slug={featured.id}>
                            <div class="kicker">
                                <time datetime={isoDate(featured.data.date)} class="accent">{formatDate(featured.data.date)}</time>
                                <span>{featured.data.category}</span>
                                <span>{readingTime(featured.body ?? '')} min read</span>
                                {featured.data.draft && <span>Draft</span>}
                            </div>
                            <h2 class="featured-title">{featured.data.title}</h2>
                            <p class="featured-desc">{featured.data.description}</p>
                        </a>
                    </section>
                )}

                {rest.length > 0 && (
                    <section aria-labelledby="recent-label" style="margin-top: 32px">
                        <div class="section-label" id="recent-label">Recent</div>
                        <div class="post-list">
                            {rest.map((post) => <PostRow post={post} />)}
                        </div>
                    </section>
                )}
            </div>

            {posts.length > 0 && (
                <aside class="index-side" aria-label="Browse">
                    <TermChips terms={categories} base="category" label="Categories" />
                    {byTag.length > 0 && (
                        <section aria-labelledby="by-tag-label">
                            <div class="section-label" id="by-tag-label">Posts by tag</div>
                            <div class="tag-groups">
                                {byTag.map((t) => (
                                    <div class="tag-group">
                                        <a class="chip" href={`/blog/tags/${t.slug}/`}>{t.name}<span class="count">{t.count}</span></a>
                                        <ul>
                                            {t.posts.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}
                                        </ul>
                                        {t.count > t.posts.length && (
                                            <a class="tag-group-more" href={`/blog/tags/${t.slug}/`}>All {t.count} posts →</a>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </section>
                    )}
                </aside>
            )}
        </div>
    </div>
    <script>
        import '../scripts/post-stats';
    </script>
</Base>
