---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="This page doesn’t exist." noindex>
    <div class="wrap">
        <header class="masthead">
            <div class="kicker"><span>404</span></div>
            <h1 class="page-title" style="margin-top: 16px">That page isn’t here.</h1>
            <p class="lede">It may have been moved, unpublished, or never existed. Try <a href="/blog/search/">searching</a> or head back to <a href="/blog/">all posts</a>.</p>
        </header>
    </div>
</Base>
