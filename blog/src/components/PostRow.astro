---
import type { Post } from '../lib/posts';
import { formatDate, isoDate, readingTime, slugify } from '../lib/text';
import Icon from './Icon.astro';

interface Props { post: Post }
const { post } = Astro.props;
const { title, description, date, category, draft } = post.data;
---
<a class="post-row" href={`/blog/${post.id}/`} data-post-slug={post.id}>
    <div class="kicker">
        <time datetime={isoDate(date)} class="accent">{formatDate(date)}</time>
        <span>{category}</span>
        <span>{readingTime(post.body ?? '')} min read</span>
        {draft && <span>Draft</span>}
    </div>
    <h3 class="post-row-title">{title}</h3>
    <p class="post-row-desc">{description}</p>
    <div class="post-row-foot">
        {post.data.tags.slice(0, 4).map((t) => <span class="chip" data-tag={slugify(t)}>{t}</span>)}
        <span class="stat" data-stat="comments" hidden><Icon name="comment" size={13} /><span></span></span>
        <span class="stat" data-stat="likes" hidden><Icon name="heart" size={13} /><span></span></span>
    </div>
</a>
