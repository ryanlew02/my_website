---
import type { Post } from '../lib/posts';
import { formatDate, isoDate, readingTime } from '../lib/text';

interface Props { post: Post }
const { post } = Astro.props;
const { title, description, date, category, draft, featured } = post.data;
---
<a class="post-row post-row--thin" href={`/blog/${post.id}/`} data-post-slug={post.id}>
    <div class="post-row-main">
        <h3 class="post-row-title">{title}</h3>
        <p class="post-row-desc">{description}</p>
    </div>
    <div class="kicker post-row-meta">
        {featured && <span class="accent">Featured</span>}
        {draft && <span>Draft</span>}
        <span>{category}</span>
        <span>{readingTime(post.body ?? '')} min</span>
        <time datetime={isoDate(date)} class="accent">{formatDate(date)}</time>
    </div>
</a>
