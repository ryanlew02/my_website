---
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
    <div class="wrap">
        <div>© {year} {SITE.author}. Words are mine; no AI writing.</div>
        <nav class="footer-links" aria-label="Elsewhere">
            <a href="/blog/rss.xml">RSS</a>
            <a href="/">Portfolio</a>
            <a href={SITE.links.github} rel="noopener noreferrer" target="_blank">GitHub</a>
            <a href={SITE.links.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
            <a href={SITE.links.medium} rel="noopener noreferrer" target="_blank">Medium</a>
        </nav>
    </div>
</footer>
