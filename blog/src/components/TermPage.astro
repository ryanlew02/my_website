---
import Base from '../layouts/Base.astro';
import PostRow from './PostRow.astro';
import TermChips from './TermChips.astro';
import type { Post, Term } from '../lib/posts';

interface Props { kind: 'Tag' | 'Category'; term: Term; posts: Post[]; all: Term[]; base: 'tags' | 'category' }
const { kind, term, posts, all, base } = Astro.props;
---
<Base
    title={`${term.name} — ${kind === 'Tag' ? 'posts tagged' : 'category'}`}
    description={`${posts.length} post${posts.length === 1 ? '' : 's'} ${kind === 'Tag' ? 'tagged' : 'in'} ${term.name}.`}
    canonical={`/blog/${base}/${term.slug}/`}
    current="blog"
>
    <div class="wrap">
        <header class="masthead" style="padding-bottom: 24px">
            <div class="kicker"><a href="/blog/">Blog</a><span>{kind}</span></div>
            <h1 class="page-title" style="margin-top: 16px">{term.name}</h1>
            <p class="lede">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
        </header>
        <div class="index-grid">
            <div class="post-list">
                {posts.map((p) => <PostRow post={p} />)}
            </div>
            <aside class="index-side">
                <div class="chips-block mobile-show"><TermChips terms={all} base={base} current={term.slug} label={kind === 'Tag' ? 'All tags' : 'All categories'} /></div>
            </aside>
        </div>
    </div>
    <script>
        import '../scripts/post-stats';
    </script>
</Base>
